<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<Description>
A small library that is useful when utilizing EntityFramework for a Data Access Layer (DAL) while adhering to Business Layer to DAL decoupling.
			
This uses the paradigm explained in https://github.com/ProphetManX/ProphetsWay.BaseDataAccess.  See the README for more information.

For more information on this project, please go to https://github.com/ProphetManX/ProphetsWay.EFTools.
		</Description>

		<Authors>G. Gordon Nasseri</Authors>
		<Company>Prophet's Way</Company>
		<Product>EFTools</Product>
		<RootNamespace>ProphetsWay.EFTools</RootNamespace>
		<AssemblyName>ProphetsWay.EFTools</AssemblyName>
		<PackageId>ProphetsWay.EFTools</PackageId>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/ProphetManX/ProphetsWay.EFTools</RepositoryUrl>
		<ApplicationIcon />
		<Win32Resource />
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<SignAssembly>false</SignAssembly>
		<PackageIcon>profile.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<!-- Source Link. Microsoft.SourceLink.GitHub ships inside the SDK, so no PackageReference is needed. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Assembly Override Properties -->
		<Version />

		<Copyright>Copyright © Prophet's Way</Copyright>
		<PackageProjectUrl>https://github.com/ProphetManX/ProphetsWay.EFTools</PackageProjectUrl>
		<PackageTags>entity-framework efcore ef-core dal data-access data-access-layer dao repository abstraction decoupling</PackageTags>
		<PackageReleaseNotes>See CHANGELOG.md, included in this package, or https://github.com/ProphetManX/ProphetsWay.EFTools/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyVersion />
		<FileVersion />
		<InformationalVersion />
	</PropertyGroup>

	<!-- Deterministic build paths in CI only; unconditionally on, it breaks local debugging. TF_BUILD is set by Azure Pipelines. -->
	<PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>


	<!-- Provider-neutral by design: a consumer chooses their own EF provider. Never add one here. -->
	<ItemGroup Condition="!$(TargetFramework.StartsWith('net4')) and $(TargetFramework.StartsWith('net'))">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="ProphetsWay.BaseDataAccess" Version="3.2.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\CHANGELOG.md" Link="CHANGELOG.md" Pack="true" PackagePath="" />
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath="" />
		<Content Include="..\profile.png" Link="profile.png" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
